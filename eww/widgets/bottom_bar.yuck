; Sound Widget
(deflisten is_system_muted "./scripts/is_system_muted.sh")

(defwidget sound []
  (button
    :class "bar-icon bottom-bar-hover"
    :onclick "./scripts/volume_mixer_popup.py &"
    (image
      :image-width 20
      :image-height 20
      :path {is_system_muted == "false" ?
        "./assets/sound_icon.svg" :
        "./assets/sound_muted_icon.svg"})))

; Battery Widget
; EWW_BATTERY is built into eww and updates every couple of seconds. total_avg
; is the charge across all batteries; the icon shows charging if any battery is
; charging.
(defwidget battery []
  (box
    :visible {jq(EWW_BATTERY, 'length') > 0}
    :tooltip "${round(EWW_BATTERY.total_avg, 0)}%"
    (image
      :image-width 20
      :image-height 20
      :path {jq(EWW_BATTERY, '[.[] | .status?] | any(. == "Charging")') ?
        "./assets/battery_charging_icon.svg" :
        round(EWW_BATTERY.total_avg, 0) < 15 ?
        "./assets/battery_empty_icon.svg" :
        round(EWW_BATTERY.total_avg, 0) <= 50 ?
        "./assets/battery_low_icon.svg" :
        "./assets/battery_icon.svg"})))

; Clock Widget
(defwidget time []
  (button
    :class "bottom-bar-hover"
    :onclick "./scripts/calendar_popup.py &"
    (box
      :orientation "v"
      (box {formattime(EWW_TIME, "%H")})
      (box {formattime(EWW_TIME, "%M")}))))

; Power Widget
(defwidget power []
  (button
    :class "bar-icon bottom-bar-hover"
    :onclick "./scripts/power_popup.py &"
    (image
      :image-width 20
      :image-height 20
      :path "./assets/power_icon.svg")))

; System Tray
(defwidget tray []
  (systray
    :class "tray"
    :orientation "v"
    :icon-size 20
    :space-evenly false
    :prepend-new true))

; Bottom bar
(defwidget bottom_bar []
  (box
    :valign "end"
    :orientation "v"
    :space-evenly false
    (battery)
    (tray)
    (sound)
    (time)
    (power)))
