#!/bin/bash

SCRIPTPATH="$(
  cd "$(dirname "$0")"
  pwd -P
)"

leftwm command "UnloadTheme"

[ -f /tmp/leftwm-theme-peri-wallpaper.pid ] && kill "$(cat /tmp/leftwm-theme-peri-wallpaper.pid)" 2>/dev/null
rm -f /tmp/leftwm-theme-peri-wallpaper.pid

if command -v eww >/dev/null 2>&1; then
  eww kill &
elif command -v /usr/bin/eww >/dev/null 2>&1; then
  /usr/bin/eww kill &
fi

rm ~/.config/eww
