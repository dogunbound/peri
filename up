#!/bin/bash
export SCRIPTPATH="$(
  cd "$(dirname "$0")"
  pwd -P
)"

if [ -f "/tmp/leftwm-theme-down" ]; then
  /tmp/leftwm-theme-down
  rm /tmp/leftwm-theme-down
fi
ln -s $SCRIPTPATH/down /tmp/leftwm-theme-down
ln -s $SCRIPTPATH/eww/ ~/.config/
export XDG_CONFIG_HOME=~/.config/

EWW_DATA_DIRS="$SCRIPTPATH/eww/assets:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

if command -v eww >/dev/null 2>&1; then
  XDG_DATA_DIRS=$EWW_DATA_DIRS eww daemon &
  eww open peri_bar
elif command -v /usr/bin/eww >/dev/null 2>&1; then
  XDG_DATA_DIRS=$EWW_DATA_DIRS /usr/bin/eww daemon &
  /usr/bin/eww open peri_bar
else
  echo "eww could not be found. Please symlink the eww binary into /usr/bin/" >>$HOME/LEFTWM-THEME-PERI-WARN
fi

if command -v nm-applet >/dev/null 2>&1; then
  pkill -x nm-applet
  nm-applet --indicator &
elif command -v /usr/bin/nm-applet >/dev/null 2>&1; then
  pkill -x nm-applet
  /usr/bin/nm-applet --indicator &
else
  echo "nm-applet could not be found. Please install it (network-manager-gnome on Debian/Ubuntu, network-manager-applet on Arch/Fedora) for the network tray icon" >>$HOME/LEFTWM-THEME-PERI-WARN
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 could not be found. Please install it (python3 on Debian/Ubuntu, python on Arch) for the calendar and volume mixer popups" >>$HOME/LEFTWM-THEME-PERI-WARN
elif ! python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
  echo "Python GTK bindings could not be found. Please install them (python3-gi and gir1.2-gtk-3.0 on Debian/Ubuntu, python-gobject on Arch) for the calendar and volume mixer popups" >>$HOME/LEFTWM-THEME-PERI-WARN
fi

leftwm command "LoadTheme $SCRIPTPATH/theme.ron"
leftwm command "LoadTheme $SCRIPTPATH/theme.toml"
